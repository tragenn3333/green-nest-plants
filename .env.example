# Copy this file to ".env" before running the project
# NEVER commit the real ".env" file to GitHub (it's already in .gitignore)

PORT=3000
SESSION_SECRET=replace-with-a-long-random-string

# Razorpay (leave blank to run in Cash-on-Delivery mode with no payment gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
