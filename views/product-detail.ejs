<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<%- include('partials/navbar') %>

<section class="section">
  <div class="container">
    <div class="pd-grid">
      <div class="pd-image">
        <img src="<%= product.image %>" alt="<%= product.name %>">
      </div>
      <div class="pd-info">
        <span class="product-category"><%= product.category %></span>
        <h1><%= product.name %></h1>
        <div class="pd-price">₹<%= product.price %></div>
        <p><%= product.description %></p>
        <p class="stock-badge"><%= product.stock > 0 ? product.stock + ' in stock' : 'Currently out of stock' %></p>

        <% if (product.stock > 0) { %>
        <div class="qty-selector">
          <button type="button" onclick="document.getElementById('qtyInput').stepDown()">−</button>
          <input type="number" id="qtyInput" value="1" min="1" max="<%= product.stock %>">
          <button type="button" onclick="document.getElementById('qtyInput').stepUp()">+</button>
        </div>
        <button class="btn btn-primary btn-block" onclick="addToCart(<%= product.id %>, '<%= product.name.replace(/'/g, "\\'") %>', <%= product.price %>, '<%= product.image %>', document.getElementById('qtyInput').value)">Add to Cart</button>
        <a href="/checkout" class="btn btn-outline btn-block" style="margin-top:10px;" onclick="addToCart(<%= product.id %>, '<%= product.name.replace(/'/g, "\\'") %>', <%= product.price %>, '<%= product.image %>', document.getElementById('qtyInput').value)">Buy Now</a>
        <% } %>

        <div class="admin-panel-box" style="margin-top:24px;">
          <h4>🚚 Delivery &amp; Plantation Charges by Area</h4>
          <table class="charges-table">
            <thead><tr><th>Area</th><th>Delivery</th><th>Plantation</th></tr></thead>
            <tbody>
              <% locations.slice(0,5).forEach(loc => { %>
              <tr><td><%= loc.area %>, <%= loc.city %></td><td>₹<%= loc.delivery_charge %></td><td>₹<%= loc.plantation_charge %></td></tr>
              <% }) %>
            </tbody>
          </table>
          <p style="margin-top:10px;"><a href="/services">See full list of areas &amp; charges →</a></p>
        </div>
      </div>
    </div>

    <% if (related.length > 0) { %>
    <div class="section-title" style="margin-top:60px;">
      <h2>You May Also Like</h2>
    </div>
    <div class="product-grid">
      <% related.forEach(p => { %>
        <div class="product-card">
          <a href="/plants/<%= p.id %>"><img src="<%= p.image %>" alt="<%= p.name %>"></a>
          <div class="product-body">
            <h3><a href="/plants/<%= p.id %>" style="color:inherit;"><%= p.name %></a></h3>
            <div class="product-price">₹<%= p.price %></div>
          </div>
        </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
