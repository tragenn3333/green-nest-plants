<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<%- include('partials/navbar') %>

<section class="section">
  <div class="container">
    <div class="section-title">
      <h1>Shop All Plants</h1>
      <p>Indoor, outdoor, flowering &amp; fruit plants — delivered across Lucknow, Kakori, Malihabad &amp; Maal</p>
    </div>

    <form method="GET" action="/plants" class="filter-bar">
      <input type="text" name="search" class="search-box" placeholder="Search plants..." value="<%= search %>">
      <button type="submit" class="btn btn-primary btn-sm">Search</button>
      <a href="/plants" class="filter-pill <%= activeCategory === '' ? 'active' : '' %>">All</a>
      <% categories.forEach(c => { %>
        <a href="/plants?category=<%= encodeURIComponent(c.name) %>" class="filter-pill <%= activeCategory === c.name ? 'active' : '' %>"><%= c.name %></a>
      <% }) %>
    </form>

    <% if (products.length === 0) { %>
      <p>No plants found. Try a different search or category.</p>
    <% } else { %>
    <div class="product-grid">
      <% products.forEach(p => { %>
        <div class="product-card">
          <a href="/plants/<%= p.id %>"><img src="<%= p.image %>" alt="<%= p.name %>"></a>
          <div class="product-body">
            <span class="product-category"><%= p.category %></span>
            <h3><a href="/plants/<%= p.id %>" style="color:inherit;"><%= p.name %></a></h3>
            <div class="product-price">₹<%= p.price %></div>
            <div class="stock-badge"><%= p.stock > 0 ? p.stock + ' in stock' : 'Out of stock' %></div>
            <div class="product-actions" style="margin-top:10px;">
              <% if (p.stock > 0) { %>
              <button class="btn btn-primary btn-sm" onclick="addToCart(<%= p.id %>, '<%= p.name.replace(/'/g, "\\'") %>', <%= p.price %>, '<%= p.image %>', 1)">Add to Cart</button>
              <% } %>
              <a href="/plants/<%= p.id %>" class="btn btn-outline btn-sm">View</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
